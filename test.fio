[global]
ioengine=libaio
direct=1
time_based
norandommap
group_reporting
disk_util=0
continue_on_error=all
rate_process=poisson
loops=10

[random-readwrite-OLTP-1]
bs=8k
size=9G
name=fio-rand-RW-1
directory=/sdb1
rw=randrw
rwmixread=60
rwmixwrite=40
iodepth=16

[random-readwrite-OLTP-2]
bs=8k
size=9G
name=fio-rand-RW-2
directory=/sdc1
rw=randrw
rwmixread=60
rwmixwrite=40
iodepth=16

